# Kicktipp-Zugangsdaten
# Kopiere diese Datei nach .env und trage deine echten Daten ein:
#     cp example.env .env
# Die .env-Datei ist über .gitignore vom Repository ausgeschlossen.

KICKTIPP_EMAIL=deine@email.de
KICKTIPP_PASSWORD=deinPasswort

# Gruppenname aus der Kicktipp-URL:
# https://www.kicktipp.de/DEIN-GRUPPENNAME/tippabgabe
KICKTIPP_GROUP=dein-gruppenname
